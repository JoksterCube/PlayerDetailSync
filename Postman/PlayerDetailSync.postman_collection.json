{
  "info": {
    "_postman_id": "f4bd8cae-84ea-4936-a27e-a4a6b33fa31d",
    "name": "PlayerDetailSync API",
    "description": "Smoke tests for the PlayerDetailSync server API. Set apiPassword locally. Run Players (summary), Player details, category requests, and Followers for complete follower records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8785",
      "type": "string"
    },
    {
      "key": "apiPassword",
      "value": "",
      "type": "string",
      "description": "Set locally. Do not sync or share the collection with a password filled in."
    },
    {
      "key": "playerId",
      "value": "",
      "type": "string",
      "description": "Populated from the first player in Players (summary)."
    },
    {
      "key": "followerId",
      "value": "",
      "type": "string",
      "description": "URL-encoded network creature ID populated by All followers. IDs may change on world reload."
    },
    {
      "key": "mountId",
      "value": "",
      "type": "string",
      "description": "URL-encoded mount ID populated by All mounts."
    },
    {
      "key": "shipId",
      "value": "",
      "type": "string",
      "description": "URL-encoded ship ID populated by All ships."
    }
  ],
  "item": [
    {
      "name": "Health rejects missing password",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated request returns 401', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Password",
            "value": "{{apiPassword}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health request succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Health fields are present', function () {",
              "    pm.expect(body.status).to.eql('ok');",
              "    pm.expect(body.updatedAtUtc).to.be.a('string');",
              "    pm.expect(body.connectedPlayerCount).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Players (summary)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Password",
            "value": "{{apiPassword}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/v1/players",
        "description": "Returns all cached players, online and offline. Saves the first playerId for the cache-only details request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Player list request succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Summary fields are present', function () {",
              "    pm.expect(body.updatedAtUtc).to.be.a('string');",
              "    pm.expect(body.players).to.be.an('array');",
              "});",
              "body.players.forEach(function (player) {",
              "    pm.expect(player.playerId).to.be.a('string').and.not.empty;",
              "    pm.expect(player.name).to.be.a('string').and.not.empty;",
              "    pm.expect(player.online).to.be.a('boolean');",
              "    pm.expect(player.lastSeenUtc).to.be.a('string').and.not.empty;",
              "    pm.expect(player.position.x).to.be.a('number');",
              "    pm.expect(player.position.y).to.be.a('number');",
              "    pm.expect(player.position.z).to.be.a('number');",
              "});",
              "if (body.players.length > 0) {",
              "    pm.collectionVariables.set('playerId', body.players[0].playerId);",
              "} else {",
              "    pm.collectionVariables.unset('playerId');",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Player details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Password",
            "value": "{{apiPassword}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}",
        "description": "Returns player identity, position, and data freshness only. Run category requests for character and other details."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Player details request succeeds', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const player = pm.response.json();",
              "pm.test('Cache availability and online metadata are present', function () {",
              "    pm.expect(player.characterDataAvailable).to.be.a('boolean');",
              "    pm.expect(player.online).to.be.a('boolean');",
              "    pm.expect(player.lastSeenUtc).to.be.a('string').and.not.empty;",
              "    pm.expect(player.characterDataAgeSeconds).to.be.a('number');",
              "});",
              "pm.test('Online players have supplied character details', function () {",
              "    if (player.online) pm.expect(player.characterDataAvailable).to.eql(true);",
              "});",
              "pm.test('Player detail is compact', function () {",
              "    pm.expect(player.playerId).to.be.a('string').and.not.empty;",
              "    pm.expect(player.position.x).to.be.a('number');",
              "    ['statuses', 'foods', 'equipment', 'followers', 'currentMount', 'lastMount', 'stats'].forEach(function (key) {",
              "        pm.expect(player).not.to.have.property(key);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Character data",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/character",
        "description": "Returns current vitals, statuses, foods, and equipped gear for one player."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body.statuses).to.be.an('array');",
            "['health', 'maxHealth', 'stamina', 'maxStamina', 'eitr', 'maxEitr'].forEach(function (key) { pm.expect(body.vitals[key]).to.be.a('number'); });",
            "pm.expect(body.foods).to.be.an('array');",
            "pm.expect(body.equipment).to.be.an('array');"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Mount",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/mount",
        "description": "Returns the single retained mount record and whether the player is riding it."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body.riding).to.be.a('boolean');",
            "if (body.mount) {",
            "    pm.expect(body.mount.name).to.be.a('string').and.not.empty;",
            "    pm.expect(body.mount.species).to.be.a('string').and.not.empty;",
            "    pm.expect(body.mount.stats.health).to.be.a('number');",
            "}"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Ship",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/ship",
        "description": "Returns the single retained ship record and whether the player is aboard."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body.aboard).to.be.a('boolean');",
            "if (body.ship) {",
            "    pm.expect(body.ship.name).to.be.a('string').and.not.empty;",
            "    pm.expect(body.ship.speed).to.be.a('number');",
            "}"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Player stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/stats",
        "description": "Returns positive native lifetime statistics; current vitals are in Character data."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body).not.to.have.property('vitals');",
            "pm.expect(body.lifetime).to.be.an('array');",
            "body.lifetime.forEach(function (stat) { pm.expect(stat.value).to.be.a('number'); });"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Private keys",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/keys",
        "description": "Returns Valheim per-player unique keys, not cryptographic keys."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body.privateKeys).to.be.an('array');"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Player activity",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/activity",
        "description": "Returns current activity and lastActivity with observation times. Offline players have current state offline and retained classified history."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "pm.expect(body).to.have.property('lastActivity');",
            "[body.activity, body.lastActivity].forEach(function (activity) { if (activity) { pm.expect(activity.state).to.be.a('string'); pm.expect(activity.activeStates).to.be.an('array'); pm.expect(activity.observedAtUtc).to.be.a('string'); } });"
          ]
        }
      }],
      "response": []
    },
    {
      "name": "Followers",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/players/{{playerId}}/followers",
        "description": "Lists last-known active followers with their full stats, status effects, and positions."
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Follower list succeeds', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('Follower list and freshness fields are present', function () {",
            "    pm.expect(body.followers).to.be.an('array');",
            "    pm.expect(body.characterDataAgeSeconds).to.be.a('number');",
            "    ['playerId', 'online', 'lastSeenUtc', 'characterDataAvailable'].forEach(function (key) { pm.expect(body).not.to.have.property(key); });",
            "});",
            "body.followers.forEach(function (follower) {",
            "    pm.expect(follower.followerId).to.be.a('string').and.not.empty;",
            "    pm.expect(follower.name).to.be.a('string').and.not.empty;",
            "    pm.expect(follower.position.x).to.be.a('number');",
            "    pm.expect(follower.stats.health).to.be.a('number');",
            "    pm.expect(follower.stats.maxHealth).to.be.a('number');",
            "    pm.expect(follower.statuses).to.be.an('array');",
            "    follower.statuses.forEach(function (effect) {",
            "        pm.expect(effect.remainingSeconds).to.be.a('number');",
            "        pm.expect(effect.hasDuration).to.be.a('boolean');",
            "    });",
            "});",
            ""
          ]
        }
      }],
      "response": []
    },
    {
      "name": "All mounts",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/mounts"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const body = pm.response.json(); pm.expect(body.mounts).to.be.an('array');",
        "body.mounts.forEach(function (mount) { pm.expect(mount.riderPlayerId).to.be.a('string').and.not.empty; });",
        "if (body.mounts.length) pm.collectionVariables.set('mountId', encodeURIComponent(body.mounts[0].mountId)); else pm.collectionVariables.unset('mountId');"
      ] } }],
      "response": []
    },
    {
      "name": "Mount details",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/mounts/{{mountId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const mount = pm.response.json(); pm.expect(mount.riderPlayerId).to.be.a('string').and.not.empty; pm.expect(mount.riding).to.be.a('boolean');"
      ] } }],
      "response": []
    },
    {
      "name": "All ships",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/ships"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const body = pm.response.json(); pm.expect(body.ships).to.be.an('array');",
        "if (body.ships.length) pm.collectionVariables.set('shipId', encodeURIComponent(body.ships[0].shipId)); else pm.collectionVariables.unset('shipId');"
      ] } }],
      "response": []
    },
    {
      "name": "Ship details",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/ships/{{shipId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const ship = pm.response.json(); pm.expect(ship.passengerPlayerIds).to.be.an('array'); pm.expect(ship.currentPassengerPlayerIds).to.be.an('array'); pm.expect(ship.lastDriverPlayerId).to.be.a('string');"
      ] } }],
      "response": []
    },
    {
      "name": "All followers",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/followers"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const body = pm.response.json(); pm.expect(body.followers).to.be.an('array');",
        "if (body.followers.length) pm.collectionVariables.set('followerId', encodeURIComponent(body.followers[0].followerId)); else pm.collectionVariables.unset('followerId');"
      ] } }],
      "response": []
    },
    {
      "name": "Follower details",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Password", "value": "{{apiPassword}}", "type": "text" }],
        "url": "{{baseUrl}}/api/v1/followers/{{followerId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.response.to.have.status(200);",
        "const follower = pm.response.json(); pm.expect(follower.followingPlayerId).to.be.a('string').and.not.empty; pm.expect(follower.stats.health).to.be.a('number');"
      ] } }],
      "response": []
    }
  ]
}
