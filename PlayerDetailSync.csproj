<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="environment.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>JoksterCube.PlayerDetailSync</RootNamespace>
    <AssemblyName>PlayerDetailSync</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(PublicizedAssembliesPath)\assembly_valheim_publicized.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(PublicizedAssembliesPath)\assembly_utils_publicized.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(CorlibPath)\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="ServerSync">
      <HintPath>Libs\ServerSync.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Splatform">
      <HintPath>$(CorlibPath)\Splatform.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CorlibPath)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Api\**\*.cs" />
    <Compile Include="Common\**\*.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Settings\ConfigInfo.cs" />
    <Compile Include="Settings\ConfigOptions.cs" />
    <Compile Include="Settings\PluginConstants.cs" />
    <Compile Include="Settings\Groups\HttpApiConfig.cs" />
    <Compile Include="Settings\Groups\ActivityConfig.cs" />
    <Compile Include="Settings\PluginConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Libs\ServerSync.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE.txt" />
    <Content Include="README.md" />
    <Content Include="Thunderstore\CHANGELOG.md" />
    <Content Include="Thunderstore\manifest.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.48" />
  </ItemGroup>
  <Target Name="SyncThunderstoreReadme" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="$(ProjectDir)README.md" DestinationFiles="$(ProjectDir)Thunderstore\README.md" />
  </Target>
  <Target Name="CopyBuildOutputToShared" AfterTargets="ILRepacker" Condition="'$(SharedBuildOutputPath)' != ''">
    <MakeDir Directories="$(SharedBuildOutputPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SharedBuildOutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="MakeThunderstorePackage" AfterTargets="ILRepacker" Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="_ThunderstoreAssembly" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ThunderstoreAssemblyVersion>@(_ThunderstoreAssembly-&gt;'%(Version)')</ThunderstoreAssemblyVersion>
      <ThunderstorePackageVersion>$(ThunderstoreAssemblyVersion.Split('.')[0]).$(ThunderstoreAssemblyVersion.Split('.')[1]).$(ThunderstoreAssemblyVersion.Split('.')[2])</ThunderstorePackageVersion>
      <ThunderstorePackageName>$(AssemblyName)_v$(ThunderstorePackageVersion)</ThunderstorePackageName>
      <ThunderstorePackageDirectory>$(BaseIntermediateOutputPath)$(Configuration)\ThunderstorePackage</ThunderstorePackageDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(ProjectDir)Thunderstore\manifest.json')" Text="Thunderstore manifest is missing." />
    <Error Condition="!Exists('$(ProjectDir)Thunderstore\CHANGELOG.md')" Text="Thunderstore changelog is missing." />
    <Error Condition="!Exists('$(ProjectDir)Thunderstore\README.md')" Text="Thunderstore README is missing." />
    <RemoveDir Directories="$(ThunderstorePackageDirectory)" />
    <MakeDir Directories="$(ThunderstorePackageDirectory)" />
    <ItemGroup>
      <ThunderstorePackageFiles Include="$(TargetPath)" />
      <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\manifest.json" />
      <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\CHANGELOG.md" />
      <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\README.md" />
      <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\icon.png" Condition="Exists('$(ProjectDir)Thunderstore\icon.png')" />
    </ItemGroup>
    <Copy SourceFiles="@(ThunderstorePackageFiles)" DestinationFolder="$(ThunderstorePackageDirectory)" />
    <ZipDirectory SourceDirectory="$(ThunderstorePackageDirectory)" DestinationFile="$(ProjectDir)Thunderstore\$(ThunderstorePackageName).zip" Overwrite="true" />
    <RemoveDir Directories="$(ThunderstorePackageDirectory)" />
    <Message Importance="High" Condition="!Exists('$(ProjectDir)Thunderstore\icon.png')" Text="Thunderstore package created without icon.png; add a 256x256 Thunderstore icon before publishing." />
  </Target>
  <Target Name="DeployPluginToServer" AfterTargets="ILRepacker" Condition="'$(DeployPlugin)' == 'true'">
    <Error Condition="'$(DeployApiPassword)' == ''" Text="Set DeployApiPassword in the ignored environment.local.props file before deploying, or use -p:DeployPlugin=false to build without deployment." />
    <Exec Command="pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Deploy-Server.ps1&quot; -AssemblyPath &quot;$(TargetPath)&quot;" />
  </Target>
</Project>